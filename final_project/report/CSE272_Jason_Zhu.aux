\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Selected frames from the light-sweep animation (60 frames, 15~fps). \textbf  {Left}: Grazing illumination from the left ($i = 0$). \textbf  {Centre}: Overhead lighting ($i = 30$). \textbf  {Right}: Grazing from the right ($i = 60$). Each style reacts distinctly to the lighting change: cel boundaries shift, tie-dye bands modulate, and ACP gradients rotate along the colour ramp.}}{7}{figure.caption.9}\protected@file@percent }
