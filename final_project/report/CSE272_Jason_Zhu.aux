\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Style function comparison on a sphere under identical lighting. \textbf  {(a)}~PBR baseline. \textbf  {(b)}~Cel-shading: hard lit/shadow boundary. \textbf  {(c)}~Tie-dye: per-channel cosine waves produce psychedelic colour banding. \textbf  {(d)}~ACP: luminance-to-gradient mapping (indigo $\to $ sunset orange).}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:styles}{{2}{6}{Style function comparison on a sphere under identical lighting. \textbf {(a)}~PBR baseline. \textbf {(b)}~Cel-shading: hard lit/shadow boundary. \textbf {(c)}~Tie-dye: per-channel cosine waves produce psychedelic colour banding. \textbf {(d)}~ACP: luminance-to-gradient mapping (indigo $\to $ sunset orange)}{figure.caption.8}{}}
