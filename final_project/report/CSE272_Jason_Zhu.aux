\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparison across pipelines. \textbf  {Left}: Pipeline~1 (deterministic cel + Sobel outlines). \textbf  {Centre}: Pipeline~2 (MC cel, $k = 256$). \textbf  {Right}: Pipeline~4 (multi-style: cel sphere, tie-dye column, ACP pedestal). Pipeline~2--4 exhibit physically correct soft shadows and colour bleeding absent in Pipeline~1.}}{6}{figure.caption.7}\protected@file@percent }
